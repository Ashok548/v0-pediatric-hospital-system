// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum WardType {
  GENERAL
  PRIVATE
  NICU
  PICU
  SURGICAL
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  RESERVED
  MAINTENANCE
}

enum ServiceCategory {
  CONSULTATION
  LAB
  PROCEDURE
  ROOM
  MISC
  RESPIRATORY
  MONITORING
  THERAPY
  INFUSION
  FEEDING
  IMAGING
}

enum BillingType {
  DAY
  HOUR
  TEST
  PROCEDURE
  VISIT
}

enum CareType {
  OP
  IP
  BOTH
}

enum AutoAddTrigger {
  NONE
  ON_OP_CREATION
  ON_IP_ADMISSION
  ON_NICU_ADMISSION
  ON_DISCHARGE
}

enum RecurrenceUnit {
  HOURLY
  DAILY
  PER_SHIFT
}

enum ServiceIntent {
  FACILITY_CHARGE
  PROFESSIONAL_FEE
  CLINICAL_PROCEDURE
  DIAGNOSTIC
  CONSUMABLE
  THERAPEUTIC
  PHARMACY
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  users       User[]
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String     @unique
  passwordHash String
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  status           UserStatus @default(ACTIVE)
  consultationFee  Decimal    @default(0) @map("consultation_fee") @db.Decimal(10, 2)
  lastLoginAt      DateTime?
  failedLogins     Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relations to other modules
  admissions           Admission[]
  appointments         Appointment[]
  prescriptions        Prescription[]
  consultations        Consultation[]
  labOrdersOrdered     LabOrder[]       @relation("LabOrderDoctor")
  labOrdersVerified    LabOrder[]       @relation("LabOrderVerifier")
  vaccinesAdministered PatientVaccine[] @relation("VaccineAdministeredBy")
  serviceOrdersOrdered ServiceOrder[]   @relation("ServiceOrderDoctor")
  opVisits             OPVisit[]
}

// ─── Master Data Models ───────────────────────────────────────────────────────

model Floor {
  id          String       @id @default(uuid())
  name        String
  floorNumber Int          @unique @map("floor_number")
  status      MasterStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  wards Ward[]

  @@map("floors")
}

model Ward {
  id        String       @id @default(uuid())
  floorId   String       @map("floor_id")
  name      String
  type      WardType     @default(GENERAL)
  totalBeds Int          @map("total_beds")
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  floor Floor @relation(fields: [floorId], references: [id])
  beds  Bed[]

  @@unique([floorId, name])
  @@index([floorId])
  @@map("wards")
}

model Bed {
  id        String    @id @default(uuid())
  wardId    String    @map("ward_id")
  bedNumber String    @map("bed_number")
  status    BedStatus @default(AVAILABLE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  ward              Ward             @relation(fields: [wardId], references: [id])
  currentAdmissions Admission[]      @relation("CurrentBed")
  transfersFrom     BedTransfer[]    @relation("TransferFrom")
  transfersTo       BedTransfer[]    @relation("TransferTo")
  activityLogs      BedActivityLog[]

  @@unique([wardId, bedNumber])
  @@index([wardId])
  @@index([status])
  @@map("beds")
}

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  description String       @default("")
  status      MasterStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  services    ServiceDepartment[]

  @@map("departments")
}


model Service {
  id          String          @id @default(uuid())
  code        String          @unique @db.VarChar(50)
  name        String
  category    ServiceCategory @default(CONSULTATION)
  subCategory String?         @map("sub_category") @db.VarChar(50)
  billingType BillingType     @default(DAY) @map("billing_type")
  careType    CareType        @default(BOTH) @map("care_type")
  basePrice   Decimal         @map("base_price") @db.Decimal(10, 2)
  taxPercent  Decimal         @default(0) @map("tax_percent") @db.Decimal(5, 2)
  hsnSacCode  String?         @map("hsn_sac_code") @db.VarChar(20)
  status      MasterStatus    @default(ACTIVE)

  // Automation Phase 1
  autoAddTrigger   AutoAddTrigger @default(NONE) @map("auto_add_trigger")
  isDefault        Boolean        @default(false) @map("is_default")
  isMandatory      Boolean        @default(false) @map("is_mandatory")
  requiresApproval Boolean        @default(false) @map("requires_approval")
  maxQtyPerDay     Int?           @map("max_qty_per_day")

  // UI & Grouping Phase 1
  uiGroup      String  @default("General") @map("ui_group") @db.VarChar(50)
  displayOrder Int     @default(100) @map("display_order")

  // Relational Context Phase 1 & 2
  departmentCodes  String[] @default([]) @map("department_codes") // legacy, keeping for safe migration
  parentServiceId  String?  @map("parent_service_id")
  parentService    Service?  @relation("ServiceHierarchy", fields: [parentServiceId], references: [id])
  childServices    Service[] @relation("ServiceHierarchy")
  
  departments      ServiceDepartment[]
  dependencies     ServiceDependency[] @relation("ServiceDeps")
  dependencyTargets ServiceDependency[] @relation("ServiceDepTargets")

  // Recurrence Phase 1
  isRecurring       Boolean          @default(false) @map("is_recurring")
  recurrenceUnit    RecurrenceUnit?  @map("recurrence_unit")
  recurrenceCap     Int?             @map("recurrence_cap")

  // Conflict Prevention Phase 1
  conflictGroupCode String?          @map("conflict_group_code") @db.VarChar(30)

  // Intent Classification Phase 1
  intent            ServiceIntent    @default(FACILITY_CHARGE)

  // Hierarchy Behavior Phase 1
  isSelectable      Boolean          @default(true) @map("is_selectable")
  isGroupHeader     Boolean          @default(false) @map("is_group_header")

  // Priority Phase 1
  autoAddPriority   Int              @default(100) @map("auto_add_priority")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  serviceOrders ServiceOrder[]

  @@unique([name, category])
  @@index([category])
  @@index([careType])
  @@index([autoAddTrigger])
  @@index([uiGroup])
  @@index([status])
  @@map("services")
}

model ServiceDepartment {
  id           String @id @default(uuid())
  serviceId    String @map("service_id")
  departmentId String @map("department_id")

  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([serviceId, departmentId])
  @@map("service_departments")
}

model ServiceDependency {
  id                String  @id @default(uuid())
  serviceId         String  @map("service_id")
  dependsOnServiceId String @map("depends_on_service_id")
  isAutoAdd         Boolean @default(true) @map("is_auto_add")

  service   Service @relation("ServiceDeps", fields: [serviceId], references: [id])
  dependsOn Service @relation("ServiceDepTargets", fields: [dependsOnServiceId], references: [id])

  @@unique([serviceId, dependsOnServiceId])
  @@map("service_dependencies")
}

// ─── Advanced Billing Master Data ────────────────────────────────────────────

enum PaymentMode {
  CASH
  CARD
  UPI
  ONLINE
  INSURANCE
  CHEQUE
}

model InsuranceProvider {
  id              String       @id @default(uuid())
  code            String       @unique @db.VarChar(30)
  name            String       @unique
  contactEmail    String?      @map("contact_email") @db.VarChar(255)
  contactPhone    String?      @map("contact_phone") @db.VarChar(20)
  claimPrefix     String       @default("CLM") @map("claim_prefix") @db.VarChar(10)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  maxCoverLimit   Decimal?     @map("max_cover_limit") @db.Decimal(12, 2)
  status          MasterStatus @default(ACTIVE)
  notes           String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@map("insurance_providers")
}

model TariffPlan {
  id            String       @id @default(uuid())
  code          String       @unique @db.VarChar(30)
  name          String       @unique
  description   String       @default("") @db.Text
  effectiveFrom DateTime     @map("effective_from")
  effectiveTo   DateTime?    @map("effective_to")
  wardType      WardType?    @map("ward_type") // null = applies to all ward types
  status        MasterStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  rates TariffRate[]

  @@index([status])
  @@index([wardType])
  @@map("tariff_plans")
}

model TariffRate {
  id              String   @id @default(uuid())
  tariffPlanId    String       @map("tariff_plan_id")
  serviceId       String       @map("service_id")
  priceOverride   Decimal      @map("price_override") @db.Decimal(10, 2)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  status          MasterStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tariffPlan TariffPlan @relation(fields: [tariffPlanId], references: [id], onDelete: Cascade)

  @@unique([tariffPlanId, serviceId])
  @@index([tariffPlanId])
  @@index([serviceId])
  @@map("tariff_rates")
}

// ─── Patient Data Models ───────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id          String   @id @default(uuid()) @db.Uuid
  uhid        String   @unique @db.VarChar(20)
  firstName   String   @map("first_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  gender      Gender
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  bloodGroup  String?  @map("blood_group") @db.VarChar(5)
  abhaId      String?  @map("abha_id") @db.VarChar(17) // Standard ABHA ID format: XX-XXXX-XXXX-XXXX

  // Contact Info
  phone                String   @db.VarChar(20)
  email                String?  @db.VarChar(100)
  guardianName         String   @map("guardian_name") @db.VarChar(200)
  guardianPhone        String?  @map("guardian_phone") @db.VarChar(20)
  guardianRelationship String?  @map("guardian_relationship") @db.VarChar(30)
  birthWeight          Decimal? @map("birth_weight") @db.Decimal(5, 2) // in kg
  address              String?  @db.Text
  city                 String?  @db.VarChar(100)
  state                String?  @db.VarChar(100)
  pincode              String?  @db.VarChar(10)

  // Using the existing UserStatus enum (ACTIVE/INACTIVE) to avoid duplication
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allergies String[] @default([])

  // Relations
  admissions    Admission[]
  growthRecords GrowthRecord[]
  bills         Bill[]
  appointments  Appointment[]
  prescriptions Prescription[]
  consultations Consultation[]
  labOrders     LabOrder[]
  vaccines      PatientVaccine[]
  serviceOrders ServiceOrder[]
  opVisits      OPVisit[]
  consents      Consent[]

  // Indexed for high-performance searching
  @@index([lastName, firstName])
  @@index([phone])
  @@index([uhid])
  @@index([status])
  @@map("patients")
}

// Dedicated table to guarantee atomic UHID sequence increments
model PatientSequence {
  id        Int      @id @default(1)
  year      Int // e.g., 2025
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, year])
  @@map("patient_sequences")
}

// ─── Admission Data Models ────────────────────────────────────────────────────

enum AdmissionStatus {
  DRAFT // Initiated, bed not physically assigned
  BED_ASSIGNED // Bed locked, patient en route
  ADMITTED // Patient in bed
  DISCHARGED // Patient has left
  CANCELLED // Admission void
}

enum AdmissionType {
  EMERGENCY
  SCHEDULED
  REFERRAL
}

enum AdmissionPriority {
  CRITICAL
  HIGH
  NORMAL
}

model Admission {
  id              String @id @default(uuid())
  admissionNumber String @unique @map("admission_number") @db.VarChar(20) // ADM-2026-000001

  // Patient link
  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  // Core admission details
  status            AdmissionStatus   @default(ADMITTED)
  admissionType     AdmissionType     @map("admission_type")
  priority          AdmissionPriority @default(NORMAL)
  department        String            @db.VarChar(50) // e.g. NICU, PICU, General, Surgery
  admittingDoctorId String?           @map("admitting_doctor_id") // FK to User (nullable until Users module fully verified)
  admittingDoctor   User?             @relation(fields: [admittingDoctorId], references: [id])
  admissionDate     DateTime          @map("admission_date")
  expectedDischarge DateTime?         @map("expected_discharge") // for bed planning
  initialDiagnosis  String?           @map("initial_diagnosis") @db.Text

  // Current bed (nullable — null before bed assignment or after discharge)
  currentBedId String? @map("current_bed_id")
  currentBed   Bed?    @relation("CurrentBed", fields: [currentBedId], references: [id])

  // NICU-specific (follows the admission, not the bed)
  gestationalAge String? @map("gestational_age") @db.VarChar(30)
  nicuRiskLevel  String? @map("nicu_risk_level") @db.VarChar(20)

  // ── Discharge Clearance (multi-step, with per-step audit) ──
  dischargeStatus   String?   @map("discharge_status") // IN_PROGRESS | COMPLETED
  dischargeType     String?   @map("discharge_type") // NORMAL | LAMA | REFERRED | EXPIRED
  clinicalCleared   Boolean   @default(false) @map("clinical_cleared")
  clinicalNote      String?   @map("clinical_note") @db.Text
  clinicalClearedAt DateTime? @map("clinical_cleared_at")
  clinicalClearedBy String?   @map("clinical_cleared_by") // User ID string
  pharmacyCleared   Boolean   @default(false) @map("pharmacy_cleared")
  pharmacyClearedAt DateTime? @map("pharmacy_cleared_at")
  pharmacyClearedBy String?   @map("pharmacy_cleared_by")
  billingCleared    Boolean   @default(false) @map("billing_cleared")
  billingClearedAt  DateTime? @map("billing_cleared_at")
  billingClearedBy  String?   @map("billing_cleared_by")
  dischargeDate     DateTime? @map("discharge_date")
  dischargeSummary  String?   @map("discharge_summary") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transfers     BedTransfer[]
  vitalsRecords NicuVitals[]
  nursingNotes  NursingNote[]
  ioRecords     IoRecord[]
  bills         Bill[]
  prescriptions Prescription[]
  consultations Consultation[]
  labOrders     LabOrder[]
  serviceOrders ServiceOrder[]
  consents      Consent[]

  @@index([patientId])
  @@index([status])
  @@index([admissionDate])
  @@map("admissions")
}

// Atomic admission number sequences (same pattern as UHID)
model AdmissionSequence {
  id        Int      @id @default(1)
  year      Int
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, year])
  @@map("admission_sequences")
}

// Full audit trail of every time a patient changes beds
model BedTransfer {
  id             String   @id @default(uuid())
  admissionId    String   @map("admission_id")
  fromBedId      String?  @map("from_bed_id") // null for initial assignment
  toBedId        String?  @map("to_bed_id") // null for discharge vacancy
  fromDepartment String?  @map("from_department") @db.VarChar(50) // ward type before transfer
  toDepartment   String?  @map("to_department") @db.VarChar(50) // ward type after transfer
  reason         String?  @db.VarChar(255)
  transferDate   DateTime @default(now()) @map("transfer_date")
  transferredBy  String?  @map("transferred_by") // User ID string

  admission Admission @relation(fields: [admissionId], references: [id])
  fromBed   Bed?      @relation("TransferFrom", fields: [fromBedId], references: [id])
  toBed     Bed?      @relation("TransferTo", fields: [toBedId], references: [id])

  @@index([admissionId])
  @@map("bed_transfers")
}

// Non-transfer bed status change events (Cleaning -> Available, Maintenance, etc.)
model BedActivityLog {
  id          String   @id @default(uuid())
  bedId       String   @map("bed_id")
  action      String   @db.VarChar(50) // MARKED_AVAILABLE | MARKED_CLEANING | MAINTENANCE | RESERVED
  notes       String?  @db.VarChar(255)
  performedBy String?  @map("performed_by") // User ID string
  createdAt   DateTime @default(now()) @map("created_at")

  bed Bed @relation(fields: [bedId], references: [id])

  @@index([bedId])
  @@map("bed_activity_logs")
}

// ─── NICU Vitals ──────────────────────────────────────────────────────────────
model NicuVitals {
  id          String    @id @default(uuid())
  admissionId String    @map("admission_id")
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  recordedAt DateTime @default(now()) @map("recorded_at")
  recordedBy String?  @map("recorded_by")

  heartRate   Int?     @map("heart_rate") // bpm
  spo2        Int? // percentage
  temperature Decimal? @db.Decimal(4, 1) // °C
  respRate    Int?     @map("respiratory_rate") // breaths/min
  bpSystolic  Int?     @map("bp_systolic")
  bpDiastolic Int?     @map("bp_diastolic")
  weight      Decimal? @db.Decimal(5, 3) // kg at recording time
  notes       String?  @db.Text

  // ── Manual Alert Flags (Chart by Exception) ──
  isCritical     Boolean   @default(false) @map("is_critical")
  alertMessage   String?   @map("alert_message") @db.VarChar(255)
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by") // User ID string

  @@index([admissionId])
  @@index([recordedAt])
  @@index([isCritical, acknowledgedAt]) // For fast dashboard queries
  @@map("nicu_vitals")
}

// ─── Growth Records ───────────────────────────────────────────────────────────
model GrowthRecord {
  id        String  @id @default(uuid())
  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  recordedAt DateTime @default(now()) @map("recorded_at")
  recordedBy String?  @map("recorded_by")

  ageMonths         Int      @map("age_months") // age at time of measurement
  weight            Decimal? @db.Decimal(5, 3) // kg
  height            Decimal? @db.Decimal(5, 1) // cm
  headCircumference Decimal? @map("head_circumference") @db.Decimal(4, 1) // cm
  notes             String?  @db.Text

  @@index([patientId])
  @@index([recordedAt])
  @@map("growth_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// NURSING & CLINICAL WORKFLOWS
// ─────────────────────────────────────────────────────────────────────────────

model NursingNote {
  id          String    @id @default(uuid())
  admissionId String    @map("admission_id")
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  noteType    String  @map("note_type") @db.VarChar(30) // PROGRESS, HANDOVER, OBSERVATION, MEDICATION, PROCEDURE
  content     String  @db.Text
  priority    String  @default("NORMAL") @db.VarChar(10) // NORMAL, URGENT, CRITICAL
  shiftPeriod String? @map("shift_period") @db.VarChar(10) // MORNING, AFTERNOON, NIGHT

  recordedAt DateTime @default(now()) @map("recorded_at")
  recordedBy String?  @map("recorded_by") // User ID or Name

  @@index([admissionId])
  @@index([recordedAt])
  @@index([noteType])
  @@map("nursing_notes")
}

model IoRecord {
  id          String    @id @default(uuid())
  admissionId String    @map("admission_id")
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  ioType   String  @map("io_type") @db.VarChar(10) // INTAKE, OUTPUT
  route    String  @db.VarChar(30) // ORAL, IV_FLUID, NG_TUBE, URINE, DRAIN, etc.
  volumeMl Float   @map("volume_ml")
  notes    String? @db.Text

  recordedAt DateTime @default(now()) @map("recorded_at")
  recordedBy String?  @map("recorded_by")

  @@index([admissionId])
  @@map("io_records")
}

// ─── Appointments Data Models ──────────────────────────────────────────────────

enum ApptStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String        @id @default(uuid())
  patientId       String        @map("patient_id") @db.Uuid
  patient         Patient       @relation(fields: [patientId], references: [id])
  doctorId        String        @map("doctor_id")
  doctor          User          @relation(fields: [doctorId], references: [id])
  department      String        @db.VarChar(100)
  appointmentDate DateTime      @map("appointment_date") @db.Date
  timeSlot        String        @map("time_slot") @db.VarChar(10) // "09:00", "09:20", etc.
  duration        Int           @default(20)
  status          ApptStatus    @default(SCHEDULED)
  type            String        @db.VarChar(50) // Consultation, Follow-up, Review, Vaccination, Procedure
  token           Int // Auto-generated daily sequence per doctor
  notes           String?       @db.Text
  chiefComplaint  String?       @map("chief_complaint") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  consultation    Consultation?
  labOrders       LabOrder[]
  serviceOrders   ServiceOrder[]
  opVisit         OPVisit?
  bill            Bill?

  @@unique([doctorId, appointmentDate, timeSlot])
  @@index([appointmentDate])
  @@index([patientId])
  @@map("appointments")
}

// ─── Billing Data Models ───────────────────────────────────────────────────────

enum BillStatus {
  DRAFT
  FINAL
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model BillSequence {
  id        Int      @id @default(1)
  year      Int
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, year])
  @@map("bill_sequences")
}

model Bill {
  id         String @id @default(uuid())
  billNumber String @unique @map("bill_number") @db.VarChar(20)

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  admissionId String?    @map("admission_id")
  admission   Admission? @relation(fields: [admissionId], references: [id])

  // OP visit link (null for IP bills)
  appointmentId String?      @unique @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  opVisitId String?   @unique @map("op_visit_id")
  opVisit   OPVisit? @relation(fields: [opVisitId], references: [id])

  tariffPlanId String? @map("tariff_plan_id")

  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  netAmount      Decimal @default(0) @map("net_amount") @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAmount      Decimal @default(0) @map("due_amount") @db.Decimal(12, 2)

  status BillStatus @default(DRAFT)
  notes  String?    @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items    BillItem[]
  payments Payment[]

  @@index([patientId])
  @@index([admissionId])
  @@index([appointmentId])
  @@index([status])
  @@map("bills")
}

model BillItem {
  id     String @id @default(uuid())
  billId String @map("bill_id")
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  serviceId   String @map("service_id")
  serviceName String @map("service_name") @db.VarChar(200) // snapshot
  serviceCode String @map("service_code") @db.VarChar(50) // snapshot

  quantity        Int     @default(1)
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalPrice      Decimal @map("total_price") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([billId])
  @@map("bill_items")
}

model Payment {
  id     String @id @default(uuid())
  billId String @map("bill_id")
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount         Decimal     @db.Decimal(12, 2)
  paymentMode    PaymentMode @map("payment_mode")
  idempotencyKey String?     @unique @map("idempotency_key") @db.VarChar(100)
  transactionRef String?     @map("transaction_ref") @db.VarChar(100)
  notes          String?     @db.Text
  paymentDate    DateTime    @default(now()) @map("payment_date")
  processedBy    String?     @map("processed_by") // User ID

  @@index([billId])
  @@map("payments")
}

// ─── OP Visit Models ──────────────────────────────────────────────────────────

enum OPVisitStatus {
