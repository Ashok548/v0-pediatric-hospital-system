// ─── Pharmacy Data Models ──────────────────────────────────────────────────────

model PrescriptionSequence {
  id        Int      @id @default(1)
  year      Int
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, year])
  @@map("prescription_sequences")
}

model Medication {
  id             String       @id @default(uuid())
  drugName       String       @map("drug_name")
  genericName    String       @map("generic_name")
  form           String       @db.VarChar(30) // Tablet, Syrup, Injection, etc.
  strength       String       @db.VarChar(50)
  unit           String       @db.VarChar(20) // tablets, ml, vials
  unitPrice      Decimal      @map("unit_price") @db.Decimal(10, 2)
  stockAvailable Int          @default(0) @map("stock_available")
  reorderLevel   Int          @default(10) @map("reorder_level")
  status         MasterStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  prescriptionItems PrescriptionItem[]
  adjustments       StockAdjustment[]

  @@index([status])
  @@map("medications")
}

model StockAdjustment {
  id              String     @id @default(uuid())
  medicationId    String     @map("medication_id")
  medication      Medication @relation(fields: [medicationId], references: [id])
  adjustmentType  String     @db.VarChar(20) // RESTOCK | WRITE_OFF | CORRECTION
  quantity        Int        // +ve for restock, -ve for write-off
  batchNumber     String?    @map("batch_number") @db.VarChar(50)
  expiryDate      DateTime?  @map("expiry_date") @db.Date // Added for Phase 4c support
  reason          String?    @db.Text
  performedBy     String     @map("performed_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  
  @@index([medicationId])
  @@map("stock_adjustments")
}

enum PrescriptionStatus {
  PENDING
  PARTIAL
  DISPENSED
  RETURNED
  CANCELLED
}

model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique @map("prescription_number") @db.VarChar(20)
  patientId          String             @map("patient_id") @db.Uuid
  patient            Patient            @relation(fields: [patientId], references: [id])
  admissionId        String?            @map("admission_id")
  admission          Admission?         @relation(fields: [admissionId], references: [id])
  opVisitId          String?            @map("op_visit_id")
  opVisit            OPVisit?           @relation(fields: [opVisitId], references: [id])
  doctorId           String             @map("doctor_id")
  doctor             User               @relation(fields: [doctorId], references: [id])
  status             PrescriptionStatus @default(PENDING)
  notes              String?            @db.Text
  advice             String?            @db.Text
  followUpDays       Int?               @map("follow_up_days")
  orderedAt          DateTime           @default(now()) @map("ordered_at")
  dispensedAt        DateTime?          @map("dispensed_at")
  dispensedBy        String?            @map("dispensed_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  items PrescriptionItem[]

  @@index([patientId])
  @@index([admissionId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId   String       @map("medication_id")
  medication     Medication   @relation(fields: [medicationId], references: [id])
  prescribedQty  Int          @map("prescribed_qty")
  dispensedQty   Int          @default(0) @map("dispensed_qty")
  
  dose           String?      @db.VarChar(100)
  frequency      String?      @db.VarChar(100)
  duration       Int?         // in days
  instructions   String?      @db.Text
  route          String?      @db.VarChar(20)
  
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([prescriptionId])
  @@map("prescription_items")
}

