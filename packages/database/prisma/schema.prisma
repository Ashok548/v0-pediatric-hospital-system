// ─── Lab Module ─────────────────────────────────────────────────────────────

model LabTestProfile {
  id          String             @id @default(uuid())
  panelName   String             @map("panel_name") @db.VarChar(100)
  category    String             @db.VarChar(50)
  sampleType  String             @map("sample_type") @db.VarChar(50)
  description String?            @db.Text
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  parameters  LabTestParameter[]
  panels      LabResultPanel[]

  @@index([category])
  @@index([isActive])
  @@map("lab_test_profiles")
}

model LabTestParameter {
  id            String          @id @default(uuid())
  profileId     String          @map("profile_id")
  profile       LabTestProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parameterName String          @map("parameter_name") @db.VarChar(100)
  unit          String          @db.VarChar(20)
  refDisplay    String          @map("ref_display") @db.VarChar(50)
  refMin        Float?          @map("ref_min")
  refMax        Float?          @map("ref_max")
  criticalMin   Float?          @map("critical_min")
  criticalMax   Float?          @map("critical_max")
  displayOrder  Int             @default(0) @map("display_order")
  isActive      Boolean         @default(true) @map("is_active")

  items         LabResultItem[]

  @@index([profileId])
  @@index([isActive])
  @@map("lab_test_parameters")
}

model LabOrderSequence {
  id        Int      @id @default(1)
  year      Int
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, year])
  @@map("lab_order_sequences")
}

enum LabOrderStatus {
  DRAFT
  PENDING_CLEARANCE
  AWAITING_SAMPLE
  SAMPLE_COLLECTED
  PROCESSING
  PARTIAL
  RESULT_ENTERED
  VERIFIED
  CANCELLED
}

model LabOrder {
  id              String   @id @default(uuid())
  orderNumber     String   @unique @map("order_number") @db.VarChar(20)

  patientId       String   @map("patient_id") @db.Uuid
  patient         Patient  @relation(fields: [patientId], references: [id])

  admissionId     String?  @map("admission_id")
  admission       Admission? @relation(fields: [admissionId], references: [id])

  appointmentId   String?  @map("appointment_id")
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])

  opVisitId       String?  @map("op_visit_id")
  opVisit         OPVisit? @relation(fields: [opVisitId], references: [id])

  patientType     String   @default("INPATIENT") @map("patient_type") @db.VarChar(20)

  doctorId        String   @map("doctor_id")
  doctor          User     @relation("LabOrderDoctor", fields: [doctorId], references: [id])
  status          LabOrderStatus @default(DRAFT)
  orderDate       DateTime @default(now()) @map("order_date")
  verifiedById    String?  @map("verified_by_id")
  verifiedBy      User?    @relation("LabOrderVerifier", fields: [verifiedById], references: [id])
  technicianNotes String?  @map("technician_notes") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  panels LabResultPanel[]

  @@index([patientId])
  @@index([admissionId])
  @@index([appointmentId])
  @@index([status])
  @@index([orderDate])
  @@map("lab_orders")
}

enum LabPanelStatus {
  PENDING
  SAMPLE_COLLECTED
  SAMPLE_REJECTED
  PROCESSING
  COMPLETED
  VERIFIED
}

model LabResultPanel {
  id            String          @id @default(uuid())
  labOrderId    String          @map("lab_order_id")
  labOrder      LabOrder        @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  testProfileId String?         @map("test_profile_id")
  testProfile   LabTestProfile? @relation(fields: [testProfileId], references: [id])
  panelName     String          @map("panel_name") @db.VarChar(100)
  category      String          @db.VarChar(50)
  sampleType    String          @map("sample_type") @db.VarChar(50)
  collectedAt   DateTime?       @map("collected_at")
  receivedAt    DateTime?       @map("received_at")
  status        LabPanelStatus  @default(PENDING)

  items LabResultItem[]

  @@index([labOrderId])
  @@map("lab_result_panels")
}

model LabResultItem {
  id              String            @id @default(uuid())
  panelId         String            @map("panel_id")
  panel           LabResultPanel    @relation(fields: [panelId], references: [id], onDelete: Cascade)
  testParameterId String?           @map("test_parameter_id")
  testParameter   LabTestParameter? @relation(fields: [testParameterId], references: [id])
  parameterName   String            @map("parameter_name") @db.VarChar(100)
  value         String?        @db.VarChar(50)
  unit          String         @db.VarChar(20)
  refDisplay    String         @map("ref_display") @db.VarChar(50)
  refMin        Float?         @map("ref_min")
  refMax        Float?         @map("ref_max")
  criticalMin   Float?         @map("critical_min")
  criticalMax   Float?         @map("critical_max")

  @@index([panelId])
  @@map("lab_result_items")
}

