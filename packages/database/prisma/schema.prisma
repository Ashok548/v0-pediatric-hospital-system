enum ConsentStatus {
  GIVEN
  REFUSED
  WITHDRAWN
}

model Consent {
  id           String        @id @default(uuid())
  patientId    String        @map("patient_id") @db.Uuid
  patient      Patient       @relation(fields: [patientId], references: [id])
  opVisitId    String?       @map("op_visit_id")
  opVisit      OPVisit?      @relation(fields: [opVisitId], references: [id])
  admissionId  String?       @map("admission_id")
  admission    Admission?    @relation(fields: [admissionId], references: [id])
  consentType  String        @map("consent_type") @db.VarChar(50)  // "GENERAL_TREATMENT", "VACCINATION", "LAB_TEST", "PROCEDURE"
  status       ConsentStatus @default(GIVEN)
  givenBy      String        @map("given_by") @db.VarChar(200)     // Guardian name
  relationship String?       @db.VarChar(30)                        // "PARENT", "GUARDIAN"
  witnessName  String?       @map("witness_name") @db.VarChar(200)
  notes        String?       @db.Text
  signedAt     DateTime      @default(now()) @map("signed_at")
  revokedAt    DateTime?     @map("revoked_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([patientId])
  @@index([opVisitId])
  @@map("consents")
}

model AuditLog {
  id         String   @id @default(uuid())
  entity     String   @db.VarChar(50)   // "OPVisit", "LabOrder", "Bill", etc.
  entityId   String   @map("entity_id")
  action     String   @db.VarChar(30)   // "STATUS_CHANGE", "CREATE", "UPDATE"
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  userId     String?  @map("user_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now())   @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Transactional Outbox Pattern ─────────────────────────────────────────────
// Events are written atomically within DB transactions and polled by the OutboxService.
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type") @db.VarChar(50)  // e.g. "Consultation", "Invoice"
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type") @db.VarChar(100)     // e.g. "OrdersSigned", "FinancialClearanceGranted"
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)     // PENDING, PROCESSED, FAILED, DEAD_LETTERED
  retryCount    Int       @default(0) @map("retry_count")
  errorReason   String?   @map("error_reason") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  processedAt   DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}
